//Write a C program to simulate a Deterministic Finite Automata (DFA) for the given
language representing strings that start with a and end with a


#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i, state = 0;

    printf("Enter a string containing a and b: ");
    scanf("%s", str);

    for (i = 0; str[i] != '\0'; i++)
    {
        if (state == 0)
        {
            if (str[i] == 'a')
                state = 1;
            else
                state = 3;
        }
        else if (state == 1)
        {
            if (str[i] == 'a')
                state = 1;
            else if (str[i] == 'b')
                state = 2;
            else
                state = 3;
        }
        else if (state == 2)
        {
            if (str[i] == 'a')
                state = 1;
            else if (str[i] == 'b')
                state = 2;
            else
                state = 3;
        }
        else
        {
            state = 3;
        }
    }

    if (state == 1)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}
